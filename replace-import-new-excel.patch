diff --git a/scripts/import-products.ts b/scripts/import-products.ts
index 3203b2d..3941ef7 100644
--- a/scripts/import-products.ts
+++ b/scripts/import-products.ts
@@ -1,9 +1,15 @@
 /**
  * Imports the product sheet into Supabase.
- *   npm run import                      (uses data/products_all_pages_1-106.xlsx)
+ *   npm run import                          (uses data/products_all_pages_1-106_1.xlsx)
  *   npm run import -- path/to/file.xlsx
- * Safe to re-run: products are matched on the "#" column (legacy_no); placement is additive;
- * opening stock is only written for products that have none yet.
+ *   npm run import -- path/to/file.xlsx --replace
+ *
+ * --replace first deletes ALL existing products together with their stock history and rack/location
+ * links, then imports the file. Price lists (and their on/off setting), locations and racks are kept.
+ * The file is read and checked before anything is deleted.
+ *
+ * Without --replace it is safe to re-run: products are matched on the "#" column (legacy_no);
+ * placement is additive; opening stock is only written for products that have none yet.
  */
 import * as XLSX from "xlsx";
 import { readFileSync, writeFileSync } from "node:fs";
@@ -11,7 +17,9 @@ import { db } from "../lib/supabase";
 import { pairPlacement, parseScheme } from "../lib/placement";
 
 type Row = Record<string, unknown>;
-const file = process.argv[2] ?? "data/products_all_pages_1-106.xlsx";
+const args = process.argv.slice(2);
+const replace = args.includes("--replace");
+const file = args.find((a) => !a.startsWith("--")) ?? "data/products_all_pages_1-106_1.xlsx";
 const sb = db();
 
 const g = (r: Row, ...keys: string[]) => {
@@ -59,6 +67,13 @@ async function main() {
     return [{ legacy, name, r, placement, scheme, ...parseScheme(scheme) }];
   });
   console.log("Rows read:", rows.length, "| importable:", items.length);
+  if (!items.length) throw new Error("No importable rows in " + file + "; nothing was deleted.");
+
+  if (replace) {
+    const { count } = await sb.from("products").select("id", { count: "exact", head: true });
+    console.log("Deleting " + (count ?? 0) + " existing products with their stock history and rack links...");
+    check("delete products", (await sb.from("products").delete().not("id", "is", null)).error);
+  }
 
   const lists = await lookup("price_lists", items.map((x) => txt(g(x.r, "list"))).filter(Boolean) as string[]);
   const companies = await lookup("companies", items.map((x) => txt(g(x.r, "company"))).filter(Boolean) as string[]);
