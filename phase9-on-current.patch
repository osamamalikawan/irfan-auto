+  }, []);
+  useEffect(() => { load(); }, [load]);
+
+  const shown = (d?.items ?? []).filter((p) => (tab === "attention" ? p.status === "overdue" || p.status === "due" : p.status === tab));
+  const owedOverdue = (d?.items ?? []).filter((p) => p.status === "overdue" || p.status === "due").reduce((x, p) => x + Math.max(p.amount - p.paid_since, 0), 0);
