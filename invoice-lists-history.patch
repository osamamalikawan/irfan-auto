+        <div className="col-span-2 flex justify-end gap-2"><button type="button" className="btn" onClick={onClose}>Cancel</button><button className="btn btn-primary" disabled={busy}>{busy ? <><Spinner /> Saving…</> : "Save"}</button></div>
+      </form>
+    </div>
+  );
+}
