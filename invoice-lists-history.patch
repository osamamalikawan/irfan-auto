+const PAGE = 50;
+
+/** One price list: search, add, edit, soft delete (with restore) and print on A4. */
+export default function ListView({ id }: { id: string }) {
+  const { can } = useMe();
+  const canEdit = can("stock.manage");
+  const [meta, setMeta] = useState<Meta | null>(null);
