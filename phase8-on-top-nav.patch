+  const tile = (k: string, v: number, warn = false) => (<div key={k} className="card p-3"><p className="text-xs text-muted">{k}</p><p className={"text-xl font-bold " + (warn && v > 0 ? "text-red" : "")}>{v}</p></div>);
+
+  return (
