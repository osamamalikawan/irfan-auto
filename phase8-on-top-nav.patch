diff --git a/lib/performance.ts b/lib/performance.ts
new file mode 100644
index 0000000..e745872
--- /dev/null
+++ b/lib/performance.ts
@@ -0,0 +1,63 @@
+import type { db } from "./supabase";
+import type { SessionUser } from "./permissions";
+import { DEFAULT_THRESHOLDS, areaTargets, daysBetween, metric, prorate, rangeOf, type Metric, type Thresholds } from "./targets";
+
+type SB = ReturnType<typeof db>;
+export const todayPk = () => new Date().toLocaleDateString("en-CA", { timeZone: "Asia/Karachi" });
+const one = <T,>(x: T | T[] | null | undefined): T | null => (Array.isArray(x) ? x[0] ?? null : x ?? null);
+
+export async function getThresholds(sb: SB): Promise<Thresholds> {
+  const { data } = await sb.from("app_settings").select("value").eq("key", "thresholds").maybeSingle();
+  const v = data?.value as Partial<Thresholds> | undefined;
+  return v && Number(v.red) > 0 && Number(v.green) > Number(v.red) ? { red: Number(v.red), green: Number(v.green) } : DEFAULT_THRESHOLDS;
+}
+
+export type PerfRow = { id: string; name: string; sub: string; sales: Metric; collection: Metric; visits: Metric; monthly: { sales: number; collection: number; visits: number } };
+
+/** Sales, collections and visits against pro-rated monthly targets, per salesman, route or area. */
+export async function computePerformance(sb: SB, user: SessionUser, o: { range: string; from: string | null; to: string | null; group: string }) {
+  const [from, to] = rangeOf(o.range, o.from, o.to, todayPk());
+  const days = daysBetween(from, to);
+  const group = ["route", "area"].includes(o.group) ? o.group : "salesman";
+  const th = await getThresholds(sb);
+
+  const actual = await sb.rpc("team_actuals", { p_from: from, p_to: to, p_group: group });
+  if (actual.error) throw new Error(actual.error.message);
+  const act = new Map<string, { sales: number; collection: number; visits: number }>(
+    (actual.data ?? []).map((r: { entity_id: string; sales: number; collection: number; visits: number }) => [r.entity_id, { sales: Number(r.sales), collection: Number(r.collection), visits: Number(r.visits) }]));
+
+  type Ent = { id: string; name: string; sub: string; t: { sales: number; collection: number; visits: number } };
+  let ents: Ent[] = [];
+  if (group === "salesman") {
+    const r = await sb.from("app_users").select("id,name,target_sales,target_collection,target_visits").eq("active", true).eq("is_salesman", true).order("name");
+    if (r.error) throw new Error(r.error.message);
+    ents = (r.data ?? []).map((u: { id: string; name: string; target_sales: number; target_collection: number; target_visits: number }) => ({ id: u.id, name: u.name, sub: "", t: { sales: Number(u.target_sales), collection: Number(u.target_collection), visits: Number(u.target_visits) } }));
+    if (user.ownOnly) ents = ents.filter((e) => e.id === user.id);
+  } else {
+    const rr = await sb.from("routes").select("id,name,code,salesman_id,target_sales,target_collection,target_visits").eq("active", true).order("name");
+    if (rr.error) throw new Error(rr.error.message);
+    let routes = rr.data ?? [];
+    if (user.ownOnly) routes = routes.filter((r: { salesman_id: string | null }) => r.salesman_id === user.id);
+    if (group === "route") {
+      ents = routes.map((r: { id: string; name: string; code: string | null; target_sales: number; target_collection: number; target_visits: number }) => ({ id: r.id, name: r.name, sub: r.code ?? "", t: { sales: Number(r.target_sales), collection: Number(r.target_collection), visits: Number(r.target_visits) } }));
+    } else {
+      const [ra, areas] = await Promise.all([sb.from("route_areas").select("route_id,area_id"), sb.from("areas").select("id,name,city:cities(name)").order("name")]);
+      if (ra.error ?? areas.error) throw new Error((ra.error ?? areas.error)!.message);
+      const ids = new Set(routes.map((r: { id: string }) => r.id));
+      const links = (ra.data ?? []).filter((x: { route_id: string }) => ids.size && ids.has(x.route_id) || !user.ownOnly);
+      const tg = areaTargets(rr.data ?? [], links);
+      const keep = (id: string) => !user.ownOnly || tg.has(id);
+      // eslint-disable-next-line @typescript-eslint/no-explicit-any
+      ents = (areas.data ?? []).filter((a: any) => keep(a.id)).map((a: any) => ({ id: a.id, name: a.name, sub: one(a.city)?.name ?? "", t: tg.get(a.id) ?? { sales: 0, collection: 0, visits: 0 } }));
+    }
+  }
+
+  const rows: PerfRow[] = ents.map((e) => {
+    const a = act.get(e.id) ?? { sales: 0, collection: 0, visits: 0 };
+    return {
+      id: e.id, name: e.name, sub: e.sub, monthly: e.t,
+      sales: metric(prorate(e.t.sales, days), a.sales, th), collection: metric(prorate(e.t.collection, days), a.collection, th), visits: metric(prorate(e.t.visits, days), a.visits, th),
+    };
+  });
+  return { from, to, days, group, thresholds: th, rows };
+}
diff --git a/lib/targets.ts b/lib/targets.ts
new file mode 100644
index 0000000..68987ba
--- /dev/null
+++ b/lib/targets.ts
@@ -0,0 +1,46 @@
+// Targets are set per month. For any period they are pro-rated by days (days / 30), like the original prototype.
+
+export type Thresholds = { red: number; green: number };
+export const DEFAULT_THRESHOLDS: Thresholds = { red: 70, green: 100 };
+export type Metric = { target: number; actual: number; remaining: number; variance: number; pct: number | null; status: "none" | "red" | "amber" | "green"; label: string };
+
+const DAY_MS = 86400000;
+export const daysBetween = (a: string, b: string) => Math.round((new Date(b + "T12:00:00Z").getTime() - new Date(a + "T12:00:00Z").getTime()) / DAY_MS) + 1;
+const addDays = (s: string, n: number) => new Date(new Date(s + "T12:00:00Z").getTime() + n * DAY_MS).toISOString().slice(0, 10);
+
+export function rangeOf(range: string, from: string | null, to: string | null, today: string): [string, string] {
+  if (range === "today") return [today, today];
+  if (range === "week") { const i = (new Date(today + "T12:00:00Z").getUTCDay() + 6) % 7; return [addDays(today, -i), today]; }
+  if (range === "month") return [today.slice(0, 8) + "01", today];
+  const f = from && /^\d{4}-\d\d-\d\d$/.test(from) ? from : today, t = to && /^\d{4}-\d\d-\d\d$/.test(to) ? to : f;
+  return t < f ? [f, f] : [f, t];
+}
+
+export const prorate = (monthly: number, days: number) => Math.round((Number(monthly) || 0) * days / 30);
+
+export function metric(target: number, actual: number, th: Thresholds = DEFAULT_THRESHOLDS): Metric {
+  const none = !target;
+  const pct = none ? null : (actual / target) * 100;
+  return {
+    target, actual, remaining: Math.max(target - actual, 0), variance: actual - target, pct: pct === null ? null : Math.round(pct * 10) / 10,
+    status: pct === null ? "none" : pct < th.red ? "red" : pct < th.green ? "amber" : "green",
+    label: pct === null ? "No target" : pct < th.red ? "Below " + th.red + "%" : pct < th.green ? "Near target" : "Target met",
+  };
+}
+
+type T = { sales: number; collection: number; visits: number };
+/** An area has no target of its own: each route's target is shared equally between the areas on that route. */
+export function areaTargets(routes: { id: string; target_sales: number; target_collection: number; target_visits: number }[], routeAreas: { route_id: string; area_id: string }[]) {
+  const out = new Map<string, T>();
+  const perRoute = new Map<string, string[]>();
+  for (const ra of routeAreas) perRoute.set(ra.route_id, [...(perRoute.get(ra.route_id) ?? []), ra.area_id]);
+  for (const r of routes) {
+    const areas = perRoute.get(r.id) ?? [];
+    for (const a of areas) {
+      const t = out.get(a) ?? { sales: 0, collection: 0, visits: 0 };
+      t.sales += Number(r.target_sales) / areas.length; t.collection += Number(r.target_collection) / areas.length; t.visits += Number(r.target_visits) / areas.length;
+      out.set(a, t);
+    }
+  }
+  return out;
+}
diff --git a/supabase/migrations/0012_team_dashboard.sql b/supabase/migrations/0012_team_dashboard.sql
new file mode 100644
index 0000000..8ac335c
--- /dev/null
+++ b/supabase/migrations/0012_team_dashboard.sql
@@ -0,0 +1,49 @@
+-- Sales Team (performance against targets) and the Dashboard numbers.
+-- Needs 0007 (sales, payments), 0008 (returns), 0010 (visits).
+
+-- Actual sales, collections and visits per salesman, route or area for a period.
+-- Sales are net of returns and exclude bilti; collections are payments actually received.
+create or replace function team_actuals(p_from date, p_to date, p_group text)
+returns table (entity_id uuid, sales numeric, collection numeric, visits bigint)
+language sql stable as $$
+  select x.k, coalesce(sum(x.s), 0), coalesce(sum(x.c), 0), coalesce(sum(x.v), 0)::bigint
+  from (
+    select case p_group when 'route' then route_id when 'area' then area_id else salesman_id end as k,
+           (total - bilti) as s, 0::numeric as c, 0 as v
+    from sales where status = 'confirmed' and sale_date between p_from and p_to
+    union all
+    select case p_group when 'route' then route_id when 'area' then area_id else salesman_id end,
+           -amount, 0::numeric, 0
+    from sale_returns where return_date between p_from and p_to
+    union all
+    select case p_group when 'route' then route_id when 'area' then area_id else collector_id end,
+           0::numeric, amount, 0
+    from payments where not reversed and pay_date between p_from and p_to
+    union all
+    select case p_group when 'route' then route_id when 'area' then area_id else user_id end,
+           0::numeric, 0::numeric, 1
+    from visits where visit_date between p_from and p_to
+  ) x
+  where x.k is not null
+  group by x.k
+$$;
+
+-- Today's numbers for the Dashboard. p_routes = null means everybody; otherwise only those routes.
+create or replace function dashboard_numbers(p_day date, p_routes uuid[]) returns jsonb language sql stable as $$
+  select jsonb_build_object(
+    'today_sales', coalesce((select sum(total - bilti) from sales
+        where status = 'confirmed' and sale_date = p_day and (p_routes is null or route_id = any(p_routes))), 0),
+    'today_invoices', coalesce((select count(*) from sales
+        where status = 'confirmed' and sale_date = p_day and (p_routes is null or route_id = any(p_routes))), 0),
+    'today_collections', coalesce((select sum(amount) from payments
+        where not reversed and pay_date = p_day and (p_routes is null or route_id = any(p_routes))), 0),
+    'receivables', coalesce((select sum(b.balance) from customer_balances b join customers c on c.id = b.customer_id
+        where b.balance > 0 and (p_routes is null or c.route_id = any(p_routes))), 0),
+    'money_in_hand', coalesce((select sum(amount) from payments where not reversed), 0)
+        - coalesce((select sum(amount) from supplier_payments where not reversed), 0)
+        - coalesce((select sum(amount) from expenses where not voided), 0)
+  )
+$$;
+
+revoke all on function team_actuals(date, date, text) from public, anon, authenticated;
+revoke all on function dashboard_numbers(date, uuid[]) from public, anon, authenticated;
